{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/index.ts",
    "src/core.ts",
    "src/wallet.ts",
    "src/widget.tsx",
    "src/constants.ts",
    "src/smart-account.ts",
    "src/**/*.test.ts",
    "scripts/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "paths": { "src/*": ["src/*"] },
  "ignore": [".venv/**", "dist/**"]
}
